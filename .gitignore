# Secrets & environment — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
key.properties
google-services.json
client_secret*.json
auth.json

# Data that must never enter VCS
*.sql
*.sql.gz
*.dump
*.eml
*.mbox
/backups/
storage/*.key

# Build / dependency output
/backend/vendor/
/backend/node_modules/
/backend/storage/logs/*
/backend/public/build/
/app/build/
/app/.dart_tool/
/app/.flutter-plugins*
.idea/
.vscode/
*.log

# Dev-only TLS material (generated by infra/scripts/dev-tls.sh)
/infra/dev/tls/
/infra/dev/secrets/
