<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development (profiling, DevTools). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- PROFILE BUILDS ONLY (device testing, never distributed): allow plain HTTP to the
         local dev server. Release builds keep usesCleartextTraffic=false and AppConfig requires https. -->
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic" />
</manifest>
