# MbunieMail backend — example environment. PLACEHOLDERS ONLY. Never commit a real .env.
# Full reference: docs/ENVIRONMENT_VARIABLES.md

APP_NAME=MbunieMail
APP_ENV=local                       # production on servers
APP_KEY=                            # php artisan key:generate
APP_DEBUG=true                      # MUST be false in production
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug                     # info (or warning) in production

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307                        # 3307 = docker dev MariaDB; 3306 on servers
DB_DATABASE=mbuniemail
DB_USERNAME=mbuniemail
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false         # true in production (HTTPS)

QUEUE_CONNECTION=redis              # "database" is an acceptable local fallback
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380                     # 6380 = docker dev Redis; 6379 on servers
REDIS_PASSWORD=

# Outbound mail for MbunieMail's own notifications (password reset, invitations).
# Dev uses Mailpit (http://127.0.0.1:8025). This is NOT the employees' mailboxes.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

HASH_DRIVER=argon2id
SANCTUM_TOKEN_PREFIX=mbm_
TRUSTED_PROXIES=                    # production behind local Nginx: 127.0.0.1,::1
CORS_ALLOWED_ORIGINS=               # empty = no browser origins allowed

MBUNIEMAIL_ORGANIZATION_NAME=MbuniTech
MBUNIEMAIL_ALLOWED_DOMAINS=example.co.tz
MBUNIEMAIL_APP_LINK_URL=https://app.example.invalid
MBUNIEMAIL_HIBP_ENABLED=true
MBUNIEMAIL_MFA_REQUIRED_FOR_ALL=false
MBUNIEMAIL_ACCESS_TOKEN_TTL=15
MBUNIEMAIL_REFRESH_TTL_DAYS=30
MBUNIEMAIL_REFRESH_IDLE_DAYS=7
MBUNIEMAIL_RESET_TTL=30
MBUNIEMAIL_AUDIT_RETENTION_DAYS=730

# Mail provider endpoints (Hostinger). Confirm exact values in hPanel.
IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
SMTP_HOST=
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_SAVES_SENT=false

# Mailbox credential encryption key file (KEK). OUTSIDE the app directory and out of
# DB backups, chmod 600. Create with: php artisan mbuniemail:kek-rotate
CREDENTIAL_KEK_PATH=/etc/mbuniemail/keys/kek.json
MBUNIEMAIL_PROVIDER_TIMEOUT=20
MBUNIEMAIL_MAX_ACCOUNTS_PER_USER=5

# Gmail (feature-flagged OFF for release 1 — see docs/SDD.md §8.3)
GMAIL_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.invalid/api/v1/oauth/google/callback

# LOCAL DEVELOPMENT ONLY (ignored in production): GreenMail fake mail server
MBUNIEMAIL_TEST_CA_FILE=
MBUNIEMAIL_ALLOW_LOOPBACK_PROVIDERS=false
GREENMAIL_PASSWORD=

# Sync, outbox and attachment policy (see docs/ENVIRONMENT_VARIABLES.md)
MBUNIEMAIL_SYNC_WINDOW_DAYS=30
MBUNIEMAIL_SYNC_INITIAL_LIMIT=2000
MBUNIEMAIL_CACHE_SNIPPETS=true
MBUNIEMAIL_MAX_RECIPIENTS=100
MBUNIEMAIL_MAX_ATTACHMENT_BYTES=26214400
MBUNIEMAIL_SEND_PER_HOUR=100
MBUNIEMAIL_RECIPIENTS_PER_HOUR=500
MBUNIEMAIL_RISKY_ATTACHMENT_POLICY=warn

# Security alerting (docs/OPERATIONS_RUNBOOK.md §3)
MBUNIEMAIL_ALERT_EMAIL=
MBUNIEMAIL_ALERT_FAILED_LOGINS=20
