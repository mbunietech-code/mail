# App downloads: Android APKs, the Windows installer, Windows update packages and
# Mac disk images (uploaded to the server, not committed).
Options -Indexes
AddType application/vnd.android.package-archive .apk
AddType application/vnd.microsoft.portable-executable .exe
AddType application/zip .zip
AddType application/x-apple-diskimage .dmg
<FilesMatch "\.(apk|exe|zip|dmg)$">
    Header set Content-Disposition "attachment"
    Header set X-Content-Type-Options "nosniff"
</FilesMatch>
